// =============================================================================
//  Gestion d'Inventaire Physique des Immobilisations — Prisma schema
//  PostgreSQL 14+ · Prisma ORM 6
//
//  Conventions
//  - Every business table is scoped by `companyId` (multi-entity / multi-société).
//  - Amounts are stored as DECIMAL(18,2) in the company's functional currency.
//  - `AssetEvent` and `CampaignScan` are append-only: a database trigger
//    (see migrations) rejects every UPDATE / DELETE to guarantee an immutable
//    audit trail ("historique immuable").
//  - Locations form a tree with a materialized path (`pathIds`) so that a whole
//    subtree (site → bâtiment → étage → direction → bureau) can be queried with a
//    single indexed prefix match.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN // Administrateur plateforme
  ACCOUNTANT // Comptable / Contrôleur de gestion
  AUDITOR // Inventoriste / Auditeur terrain
  VIEWER // Lecture seule
}

enum LocationType {
  SITE
  BUILDING
  FLOOR
  DEPARTMENT
  ZONE
  ROOM
}

enum DepreciationMethod {
  LINEAR // Linéaire
  DECLINING // Dégressif
  NONE // Non amortissable (terrains, œuvres d'art…)
}

enum AssetStatus {
  IN_SERVICE // En service
  IN_STOCK // En stock / Non affecté
  UNDER_MAINTENANCE // En maintenance / Panne
  DISPOSED // Mis au rebut (cession / destruction)
  MISSING // Disparu / Écart négatif
}

enum AssetCondition {
  GOOD // Bon état
  DAMAGED // Endommagé
  TO_REPAIR // À réparer
}

enum TagStatus {
  UNTAGGED // Non étiqueté
  PRINTED // Étiquette imprimée
  AFFIXED // Étiquette posée (confirmée par un scan)
}

enum AssetOrigin {
  INVOICE // Généré depuis une facture (extraction IA)
  MANUAL // Saisie manuelle
  IMPORT // Import du fichier comptable
  SURPLUS // Excédent d'inventaire intégré
}

enum DisposalType {
  SALE // Cession
  DESTRUCTION // Destruction / Mise au rebut
  DONATION // Don
  THEFT_LOSS // Vol / Perte
}

enum AssetEventType {
  CREATED
  UPDATED
  INVOICE_LINKED
  LOCATION_TRANSFER
  CUSTODIAN_ASSIGNED
  CUSTODIAN_RETURNED
  STATUS_CHANGE
  CONDITION_CHANGE
  TAG_PRINTED
  TAG_AFFIXED
  SCANNED
  DISPOSED
  RECONCILIATION_ADJUSTMENT
}

enum InvoiceStatus {
  UPLOADED // Déposée, en attente d'extraction
  EXTRACTING // Extraction IA en cours
  EXTRACTED // Extraite, en attente de validation
  FAILED // Échec d'extraction
  VALIDATED // Validée, fiches immobilisations générées
  REJECTED // Rejetée (document non pertinent)
}

enum CampaignStatus {
  DRAFT // Préparation
  IN_PROGRESS // Comptage en cours
  COUNT_CLOSED // Comptage clôturé, rapprochement / régularisations
  VALIDATED // PV validé, campagne verrouillée
}

enum ReconciliationCategory {
  MATCH // Conformes
  MISPLACED // Écarts de localisation / affectation
  MISSING // Écarts négatifs (manquants)
  SURPLUS // Écarts positifs (excédents)
}

enum ResolutionStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum SurplusStatus {
  PENDING
  INTEGRATED
  REJECTED
}

// -----------------------------------------------------------------------------
// Identity & multi-entity
// -----------------------------------------------------------------------------

model Company {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  legalName               String?
  legalForm               String?
  ice                     String? // Identifiant Commun de l'Entreprise (15 chiffres)
  taxId                   String? // Identifiant Fiscal (IF)
  tradeRegister           String? // Registre de Commerce (RC)
  address                 String?
  city                    String?
  country                 String   @default("MA")
  currency                String   @default("MAD")
  capitalizationThreshold Decimal  @default(0) @db.Decimal(18, 2) // Seuil d'immobilisation HT
  fiscalYearStartMonth    Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships     UserCompany[]
  locations       Location[]
  costCenters     CostCenter[]
  departments     Department[]
  employees       Employee[]
  categories      AssetCategory[]
  suppliers       Supplier[]
  invoices        Invoice[]
  assets          Asset[]
  events          AssetEvent[]
  assignments     CustodianAssignment[]
  campaigns       InventoryCampaign[]
  labelPrintJobs  LabelPrintJob[]
  sequences       Sequence[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships         UserCompany[]
  uploadedInvoices    Invoice[]               @relation("InvoiceUploadedBy")
  validatedInvoices   Invoice[]               @relation("InvoiceValidatedBy")
  createdAssets       Asset[]                 @relation("AssetCreatedBy")
  events              AssetEvent[]
  assignmentsMade     CustodianAssignment[]
  campaignsCreated    InventoryCampaign[]     @relation("CampaignCreatedBy")
  campaignsValidated  InventoryCampaign[]     @relation("CampaignValidatedBy")
  campaignMemberships CampaignMember[]
  scans               CampaignScan[]
  surplusesFound      CampaignSurplus[]       @relation("SurplusFoundBy")
  surplusesResolved   CampaignSurplus[]       @relation("SurplusResolvedBy")
  resolutions         ReconciliationResult[]
  labelPrintJobs      LabelPrintJob[]
}

model UserCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

// -----------------------------------------------------------------------------
// Organisation & locations
// -----------------------------------------------------------------------------

model Location {
  id           String       @id @default(cuid())
  companyId    String
  parentId     String?
  type         LocationType
  code         String
  name         String
  path         String // "Siège Casablanca > Étage 2 > Direction Financière > Bureau 204"
  pathIds      String // "/<rootId>/<childId>/.../<selfId>/"
  depth        Int          @default(0)
  departmentId String?
  address      String?
  latitude     Float?
  longitude    Float?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent     Location?   @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Location[]  @relation("LocationTree")
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assets               Asset[]
  eventsFrom           AssetEvent[]            @relation("EventFromLocation")
  eventsTo             AssetEvent[]            @relation("EventToLocation")
  campaignScopes       CampaignScopeLocation[]
  scans                CampaignScan[]
  surpluses            CampaignSurplus[]
  snapshotExpectations CampaignSnapshotItem[]

  @@unique([companyId, code])
  @@index([companyId, pathIds])
  @@index([parentId])
}

model CostCenter {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments Department[]
  assets      Asset[]

  @@unique([companyId, code])
}

model Department {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  costCenterId String?
  managerName  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  employees  Employee[]
  locations  Location[]
  assets     Asset[]

  @@unique([companyId, code])
}

model Employee {
  id           String   @id @default(cuid())
  companyId    String
  matricule    String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  jobTitle     String?
  departmentId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assets        Asset[]
  assignments   CustodianAssignment[]
  eventsFrom    AssetEvent[]          @relation("EventFromCustodian")
  eventsTo      AssetEvent[]          @relation("EventToCustodian")

  @@unique([companyId, matricule])
  @@index([companyId, lastName])
}

// -----------------------------------------------------------------------------
// Accounting referential
// -----------------------------------------------------------------------------

model AssetCategory {
  id                     String             @id @default(cuid())
  companyId              String
  code                   String // Code court utilisé par l'IA (ex: INFO, MOB, TRANS)
  name                   String // "Matériel informatique"
  description            String? // Indices de classification transmis à l'IA
  assetAccount           String // Compte d'immobilisation CGNC (ex: 2355)
  depreciationAccount    String? // Compte d'amortissement (ex: 28355)
  defaultMethod          DepreciationMethod @default(LINEAR)
  defaultUsefulLifeYears Int                @default(5)
  decliningCoefficient   Decimal?           @db.Decimal(4, 2)
  trackPhysically        Boolean            @default(true) // Inclus dans les inventaires physiques
  color                  String?
  active                 Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets          Asset[]
  invoiceLines    InvoiceLine[]
  campaignScopes  CampaignScopeCategory[]
  surpluses       CampaignSurplus[]
  snapshotItems   CampaignSnapshotItem[]

  @@unique([companyId, code])
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  ice           String?
  taxId         String?
  tradeRegister String?
  address       String?
  city          String?
  email         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  assets   Asset[]

  @@index([companyId, name])
  @@index([companyId, ice])
}

// -----------------------------------------------------------------------------
// Supplier invoices & AI extraction
// -----------------------------------------------------------------------------

model Invoice {
  id                    String        @id @default(cuid())
  companyId             String
  supplierId            String?
  number                String?
  invoiceDate           DateTime?     @db.Date
  dueDate               DateTime?     @db.Date
  currency              String        @default("MAD")
  totalHT               Decimal?      @db.Decimal(18, 2)
  totalVAT              Decimal?      @db.Decimal(18, 2)
  totalTTC              Decimal?      @db.Decimal(18, 2)
  documentType          String?
  status                InvoiceStatus @default(UPLOADED)
  fileKey               String
  fileName              String
  mimeType              String
  fileSize              Int
  fileSha256            String
  extractedData         Json?
  extractionModel       String?
  extractionStartedAt   DateTime?
  extractionCompletedAt DateTime?
  extractionDurationMs  Int?
  extractionError       String?
  extractionWarnings    String[]      @default([])
  confidence            Float?
  uploadedById          String
  validatedById         String?
  validatedAt           DateTime?
  rejectionReason       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  uploadedBy  User          @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])
  validatedBy User?         @relation("InvoiceValidatedBy", fields: [validatedById], references: [id])
  lines       InvoiceLine[]
  assets      Asset[]

  @@index([companyId, status])
  @@index([companyId, fileSha256])
  @@index([companyId, supplierId, number])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  lineNo         Int
  designation    String
  specifications String?
  brand          String?
  model          String?
  serialNumbers  String[] @default([])
  quantity       Decimal  @db.Decimal(12, 3)
  unitPriceHT    Decimal  @db.Decimal(18, 2)
  vatRate        Decimal  @db.Decimal(5, 2)
  totalHT        Decimal  @db.Decimal(18, 2)
  isFixedAsset   Boolean  @default(true)
  splitIntoUnits Boolean  @default(true)
  categoryId     String?
  aiCategoryCode String?
  aiConfidence   Float?
  createdAt      DateTime @default(now())

  invoice  Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assets   Asset[]

  @@unique([invoiceId, lineNo])
}

// -----------------------------------------------------------------------------
// Fixed asset register (Fichier des immobilisations)
// -----------------------------------------------------------------------------

model Asset {
  id                   String             @id @default(cuid())
  companyId            String
  code                 String // IMM-2026-00042
  designation          String
  description          String?
  brand                String?
  model                String?
  serialNumber         String?
  quantity             Int                @default(1)
  categoryId           String
  supplierId           String?
  invoiceId            String?
  invoiceLineId        String?
  acquisitionDate      DateTime           @db.Date
  commissioningDate    DateTime?          @db.Date
  acquisitionValue     Decimal            @db.Decimal(18, 2) // Valeur d'origine HT
  vatRate              Decimal?           @db.Decimal(5, 2)
  currency             String             @default("MAD")
  depreciationMethod   DepreciationMethod @default(LINEAR)
  usefulLifeYears      Int                @default(5)
  decliningCoefficient Decimal?           @db.Decimal(4, 2)
  residualValue        Decimal            @default(0) @db.Decimal(18, 2)
  status               AssetStatus        @default(IN_STOCK)
  condition            AssetCondition     @default(GOOD)
  origin               AssetOrigin        @default(MANUAL)
  tagStatus            TagStatus          @default(UNTAGGED)
  tagPrintedAt         DateTime?
  tagAffixedAt         DateTime?
  locationId           String?
  departmentId         String?
  costCenterId         String?
  custodianId          String?
  photoKey             String?
  warrantyEndDate      DateTime?          @db.Date
  disposalDate         DateTime?          @db.Date
  disposalType         DisposalType?
  disposalValue        Decimal?           @db.Decimal(18, 2)
  disposalReason       String?
  lastSeenAt           DateTime?
  notes                String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      AssetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLine   InvoiceLine?   @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  custodian     Employee?      @relation(fields: [custodianId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  events               AssetEvent[]
  assignments          CustodianAssignment[]
  snapshotItems        CampaignSnapshotItem[]
  scans                CampaignScan[]
  integratedFrom       CampaignSurplus?       @relation("SurplusIntegratedAsset")
  reconciliationResults ReconciliationResult[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, locationId])
  @@index([companyId, tagStatus])
  @@index([companyId, acquisitionDate])
  @@index([companyId, serialNumber])
}

/// Append-only audit trail. UPDATE / DELETE are rejected by a database trigger.
model AssetEvent {
  id              String         @id @default(cuid())
  companyId       String
  assetId         String
  type            AssetEventType
  summary         String
  fromLocationId  String?
  toLocationId    String?
  fromCustodianId String?
  toCustodianId   String?
  fromStatus      AssetStatus?
  toStatus        AssetStatus?
  data            Json?
  campaignId      String?
  userId          String?
  latitude        Float?
  longitude       Float?
  gpsAccuracy     Float?
  ipAddress       String?
  createdAt       DateTime       @default(now())

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fromLocation  Location?          @relation("EventFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location?          @relation("EventToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  fromCustodian Employee?          @relation("EventFromCustodian", fields: [fromCustodianId], references: [id], onDelete: Restrict)
  toCustodian   Employee?          @relation("EventToCustodian", fields: [toCustodianId], references: [id], onDelete: Restrict)
  campaign      InventoryCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user          User?              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@index([campaignId])
}

/// Affectation nominative d'un bien à un collaborateur, avec signature électronique.
model CustodianAssignment {
  id                  String         @id @default(cuid())
  companyId           String
  assetId             String
  employeeId          String
  assignedAt          DateTime       @default(now())
  returnedAt          DateTime?
  conditionAtHandover AssetCondition @default(GOOD)
  conditionAtReturn   AssetCondition?
  signatureKey        String?
  signerName          String?
  signedAt            DateTime?
  signerIp            String?
  notes               String?
  assignedById        String?
  createdAt           DateTime       @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([assetId, assignedAt])
  @@index([employeeId])
}

model LabelPrintJob {
  id          String   @id @default(cuid())
  companyId   String
  templateKey String
  labelCount  Int
  assetIds    String[]
  createdById String?
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

// -----------------------------------------------------------------------------
// Inventory campaigns (Campagnes d'inventaire)
// -----------------------------------------------------------------------------

model InventoryCampaign {
  id               String         @id @default(cuid())
  companyId        String
  code             String
  name             String
  description      String?
  status           CampaignStatus @default(DRAFT)
  plannedStartDate DateTime?      @db.Date
  plannedEndDate   DateTime?      @db.Date
  launchedAt       DateTime?
  countClosedAt    DateTime?
  reconciledAt     DateTime?
  validatedAt      DateTime?
  pvNumber         String?
  pvObservations   String?
  createdById      String
  validatedById    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  validatedBy     User?                   @relation("CampaignValidatedBy", fields: [validatedById], references: [id])
  members         CampaignMember[]
  scopeLocations  CampaignScopeLocation[]
  scopeCategories CampaignScopeCategory[]
  snapshotItems   CampaignSnapshotItem[]
  scans           CampaignScan[]
  surpluses       CampaignSurplus[]
  results         ReconciliationResult[]
  events          AssetEvent[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model CampaignMember {
  campaignId String
  userId     String
  role       String @default("COUNTER") // LEAD | COUNTER

  campaign InventoryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
}

model CampaignScopeLocation {
  campaignId String
  locationId String

  campaign InventoryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([campaignId, locationId])
}

model CampaignScopeCategory {
  campaignId String
  categoryId String

  campaign InventoryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category AssetCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([campaignId, categoryId])
}

/// Fichier comptable théorique figé au lancement de la campagne.
model CampaignSnapshotItem {
  id                      String      @id @default(cuid())
  campaignId              String
  assetId                 String
  assetCode               String
  designation             String
  serialNumber            String?
  categoryId              String
  categoryName            String
  expectedLocationId      String?
  expectedLocationPath    String?
  expectedCustodianName   String?
  expectedStatus          AssetStatus
  acquisitionDate         DateTime    @db.Date
  grossValue              Decimal     @db.Decimal(18, 2)
  accumulatedDepreciation Decimal     @db.Decimal(18, 2)
  netBookValue            Decimal     @db.Decimal(18, 2)
  createdAt               DateTime    @default(now())

  campaign         InventoryCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset            Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  category         AssetCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expectedLocation Location?              @relation(fields: [expectedLocationId], references: [id], onDelete: SetNull)
  scans            CampaignScan[]
  results          ReconciliationResult[]

  @@unique([campaignId, assetId])
  @@index([campaignId, expectedLocationId])
  @@index([campaignId, assetCode])
}

/// Every physical scan performed in the field. Append-only.
model CampaignScan {
  id                 String         @id @default(cuid())
  campaignId         String
  clientId           String         @unique // idempotency key generated on the device
  assetId            String
  snapshotItemId     String?
  scannedCode        String
  locationId         String
  condition          AssetCondition @default(GOOD)
  isLocationMismatch Boolean        @default(false)
  transferProposed   Boolean        @default(false)
  manualEntry        Boolean        @default(false)
  photoKey           String?
  notes              String?
  latitude           Float?
  longitude          Float?
  gpsAccuracy        Float?
  deviceInfo         String?
  scannedById        String
  scannedAt          DateTime
  receivedAt         DateTime       @default(now())

  campaign     InventoryCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  asset        Asset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  snapshotItem CampaignSnapshotItem? @relation(fields: [snapshotItemId], references: [id], onDelete: Restrict)
  location     Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  scannedBy    User                  @relation(fields: [scannedById], references: [id], onDelete: Restrict)
  results      ReconciliationResult[]

  @@index([campaignId, assetId, scannedAt])
  @@index([campaignId, locationId])
  @@index([campaignId, scannedAt])
}

/// Biens trouvés physiquement mais absents du fichier (ou non étiquetés).
model CampaignSurplus {
  id               String         @id @default(cuid())
  campaignId       String
  clientId         String         @unique
  tempTag          String
  scannedCode      String?
  designation      String
  description      String?
  brand            String?
  model            String?
  serialNumber     String?
  categoryId       String?
  estimatedValue   Decimal?       @db.Decimal(18, 2)
  condition        AssetCondition @default(GOOD)
  locationId       String
  photoKey         String?
  notes            String?
  latitude         Float?
  longitude        Float?
  gpsAccuracy      Float?
  foundById        String
  foundAt          DateTime
  status           SurplusStatus  @default(PENDING)
  resolvedAssetId  String?        @unique
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime       @default(now())

  campaign      InventoryCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category      AssetCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location      Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  foundBy       User                   @relation("SurplusFoundBy", fields: [foundById], references: [id], onDelete: Restrict)
  resolvedBy    User?                  @relation("SurplusResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAsset Asset?                 @relation("SurplusIntegratedAsset", fields: [resolvedAssetId], references: [id], onDelete: SetNull)
  results       ReconciliationResult[]

  @@unique([campaignId, tempTag])
  @@index([campaignId, status])
}

/// Résultat du rapprochement physico-comptable (recalculable jusqu'à validation du PV).
model ReconciliationResult {
  id                   String                 @id @default(cuid())
  campaignId           String
  category             ReconciliationCategory
  assetId              String?
  snapshotItemId       String?
  scanId               String?
  surplusId            String?
  assetCode            String
  designation          String
  categoryName         String?
  serialNumber         String?
  expectedLocationId   String?
  expectedLocationPath String?
  foundLocationId      String?
  foundLocationPath    String?
  expectedStatus       AssetStatus?
  condition            AssetCondition?
  grossValue           Decimal                @db.Decimal(18, 2)
  netBookValue         Decimal                @db.Decimal(18, 2)
  reasons              String[]               @default([])
  resolution           ResolutionStatus       @default(OPEN)
  resolutionAction     String?
  resolutionNote       String?
  resolvedById         String?
  resolvedAt           DateTime?
  createdAt            DateTime               @default(now())

  campaign     InventoryCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset        Asset?                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  snapshotItem CampaignSnapshotItem? @relation(fields: [snapshotItemId], references: [id], onDelete: Cascade)
  scan         CampaignScan?         @relation(fields: [scanId], references: [id], onDelete: Restrict)
  surplus      CampaignSurplus?      @relation(fields: [surplusId], references: [id], onDelete: Cascade)
  resolvedBy   User?                 @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([campaignId, category])
  @@index([campaignId, resolution])
}

// -----------------------------------------------------------------------------
// Technical
// -----------------------------------------------------------------------------

/// Gap-free counters (asset codes, campaign codes, temporary tags…).
model Sequence {
  companyId String
  key       String
  value     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
}
