# -----------------------------------------------------------------------------
# Base de données PostgreSQL (14+)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://immo:immo@localhost:5432/immo_inventory?schema=public"

# -----------------------------------------------------------------------------
# Sécurité des sessions — chaîne aléatoire d'au moins 32 caractères
#   openssl rand -base64 48
# -----------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-secret-of-at-least-32-chars"

# URL publique de l'application : encodée dans les QR codes des étiquettes
# (un smartphone qui scanne l'étiquette ouvre directement la fiche du bien).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Extraction IA des factures — Google Gemini (https://aistudio.google.com/apikey)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Budget de raisonnement (tokens). -1 = dynamique, 0 = désactivé.
GEMINI_THINKING_BUDGET="1024"
# Délai maximal d'un appel Gemini (ms)
GEMINI_TIMEOUT_MS="120000"

# -----------------------------------------------------------------------------
# Stockage des fichiers (factures, photos terrain, signatures)
# -----------------------------------------------------------------------------
STORAGE_DIR="./storage"
# Taille maximale d'une facture déposée (Mo)
MAX_INVOICE_UPLOAD_MB="25"
