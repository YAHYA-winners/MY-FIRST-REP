{
  "name": "immo-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion d'inventaire physique des immobilisations — plateforme EAM / Fixed Asset avec extraction IA des factures, étiquetage QR, inventaire terrain et rapprochement physico-comptable.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html5-qrcode": "2.3.8",
    "jose": "6.2.18",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "qrcode.react": "4.2.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.2",
    "tailwindcss-animate": "1.0.7",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
